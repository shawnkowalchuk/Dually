# --- Build output ---------------------------------------------------------------------------
build/
.gradle/
# Kotlin compiler session files
.kotlin/
# Native build caches (none today; listed so a future NDK step cannot leak them)
.cxx/
.externalNativeBuild/

# --- This machine only ----------------------------------------------------------------------
# Path to the Android SDK on this Mac. Android Studio recreates it.
local.properties
# Screenshots and recordings taken from Android Studio
captures/

# --- Secrets: never commit ------------------------------------------------------------------
# A signing keystore and its passwords are the only secrets this app will ever have.
# They live outside the repository; these lines are the backstop if one is copied in.
*.jks
*.keystore
keystore.properties
.env
.env.*
# The website's deploy key (ADR-003) lives only in GitHub's secrets. A downloaded copy of it,
# under the names Firebase and Google Cloud give such files, must never be committed.
*firebase-adminsdk*.json
service-account*.json

# --- Android Studio --------------------------------------------------------------------------
# Everything under .idea is per-machine state, except the folders below. Those hold settings
# that change how code is written or run, so they are shared.
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/runConfigurations/
*.iml

# --- macOS -----------------------------------------------------------------------------------
.DS_Store

# Claude Code's per-machine settings. Never shared.
.claude/settings.local.json

# --- A personal trip-start sound --------------------------------------------------------------
# An audio file placed in this folder as trip_start_chirp.<ext> replaces the bundled chirp in
# debug builds made on this machine (see README, "Your own connect sound"). It stays out of
# git on purpose: the owner's own clip may be someone else's copyright.
app/src/debug/res/raw/
/r2d2.mp3

# --- The website (ADR-003) --------------------------------------------------------------------
# What the Firebase command-line tool leaves behind on the Mac after a deploy or a local preview.
.firebase/
firebase-debug.log
firebase-debug.*.log

# --- The mascot's source and the marketing kit: on the owner's Mac only --------------------------
# Since 2026-10-11 these two folders are not in the repository (FINDINGS_LOG, that date): the
# mascot's Blender file with the scripts that build, draw and pack him, and the pictures and
# videos for the shop pages. The repository is public; these are kept where only the owner has
# them. What the app and the website show of the mascot is in app/src/main/res/ and website/.
/design/
/marketing/

# --- Python scripts (tools/) --------------------------------------------------------------------
# What Python leaves beside a script when one of them reads another.
__pycache__/
