{
  "name": "dually-firebase",
  "private": true,
  "description": "The security rules of Dually's cloud backup (ADR-012), and their tests on Firebase's emulator.",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-dually \"node --test --test-concurrency=1 test/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.3.0",
    "firebase-admin": "14.5.1",
    "firebase-tools": "15.36.0"
  }
}
