<?xml version="1.0" encoding="utf-8"?>
<!--
    The "D" of the app's mark (since 2026-10-13, ADR-010; until then the "M" of the old name):
    the brand design's "Icon B, Monogram". The letter is a drawn shape, the same one the mark at
    the top of every screen is drawn with (core/designsystem/component/AppMark.kt): its path is
    written around the point 0, 0 in a box 72 wide and 76 high, and the group moves it to the
    middle of the icon and sizes it. AppMarkTest fails if the path here is another one.

    It is as large on the icon as the design draws it: there the letter takes up 0.528 of the
    square's width, and a launcher shows the middle 72 of this 108 x 108 canvas, so the letter
    is 38 wide and 40.1 high here, in the middle, well inside the central 66 x 66 safe zone
    that every launcher shape leaves uncut.

    The dark is the colour of the letter on the mark (res/values/colors.xml). As the monochrome
    layer only the shape is used.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.528"
        android:scaleY="0.528"
        android:translateX="54"
        android:translateY="54">
        <path
            android:fillColor="@color/milo_mark_letter"
            android:fillType="evenOdd"
            android:pathData="M-36,-38H0A36,38 0 0 1 0,38H-36ZM-18,-20H0A18,20 0 0 1 0,20H-18Z" />
    </group>
</vector>
