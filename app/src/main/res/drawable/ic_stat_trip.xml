<?xml version="1.0" encoding="utf-8"?>
<!--
    The small icon of every notification of the app: the app's mark, a rounded square with the
    letter cut out of it (Shawn's choice of 2026-10-07, then with an "M"; the "D" since
    2026-10-13, ADR-010). Android draws it itself, in the status bar and the notification shade,
    using only the shape: every opaque pixel is painted in one colour of the system's choosing,
    so the orange of the mark cannot be in here. The orange is the notifications' colour instead
    (res/values/colors.xml), which Android uses around this shape where it adds colour at all.
    That is why the size and the white fill are written here and not taken from the design
    tokens, which exist only inside Compose.

    The letter is the mark's own (core/designsystem/component/AppMark.kt), written around the
    point 0, 0 in a box 72 wide and 76 high. The group makes it a sixth as large and moves it to
    the middle of the 24 units, so it is 12 wide and 12.7 high: larger on the square than on the
    mark, because at the mark's size its strokes would be about a pixel and a half wide in the
    status bar. The square is written in the letter's own measure, so that one path holds both:
    120 wide there is 20 of the 24 units here, the margin Android's status bar icons keep, and
    its corner of 36 is 6 here.

    One path: "evenOdd" makes the letter a hole in the square, and the letter's counter, a hole
    in that hole, is filled again.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.16667"
        android:scaleY="0.16667"
        android:translateX="12"
        android:translateY="12">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M-24,-60h48a36,36 0 0 1 36,36v48a36,36 0 0 1 -36,36h-48a36,36 0 0 1 -36,-36v-48a36,36 0 0 1 36,-36z M-36,-38H0A36,38 0 0 1 0,38H-36ZM-18,-20H0A18,20 0 0 1 0,20H-18Z" />
    </group>
</vector>
