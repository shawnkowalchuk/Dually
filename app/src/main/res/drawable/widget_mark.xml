<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's mark at the top of the widget: the orange square with the dark "D" on it, as the
    design draws the mark in a top line (a square of 40 with a corner of 11, the letter at three
    tenths). The home screen app draws it, outside Compose, so its two colours are in
    res/values/colors.xml and its letter is written here a second time: the mark's own path
    (core/designsystem/component/AppMark.kt), which AppMarkTest holds to.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp"
    android:height="22dp"
    android:viewportWidth="40"
    android:viewportHeight="40">
    <path
        android:fillColor="@color/milo_mark_ground"
        android:pathData="M11,0h18a11,11 0 0 1 11,11v18a11,11 0 0 1 -11,11h-18a11,11 0 0 1 -11,-11v-18a11,11 0 0 1 11,-11z" />
    <group
        android:scaleX="0.3"
        android:scaleY="0.3"
        android:translateX="20"
        android:translateY="20">
        <path
            android:fillColor="@color/milo_mark_letter"
            android:fillType="evenOdd"
            android:pathData="M-36,-38H0A36,38 0 0 1 0,38H-36ZM-18,-20H0A18,20 0 0 1 0,20H-18Z" />
    </group>
</vector>
