<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon made only of vectors, so there are no PNGs to regenerate.
    minSdk is 34 and every such phone supports adaptive icons, which is why there is no bitmap
    fallback and no separate round icon. Since 2026-10-13 (ADR-010) it is the brand design's
    "Icon A, Face" on the mark's orange: the mascot's two dials and his grin
    (ic_launcher_foreground.xml, written by tools/make_launcher_icon.py). The monochrome layer
    is what Android tints when "themed icons" is switched on; Android uses only its shape, and
    one colour cannot show a face, so that layer is the letter of the app's mark alone.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
