<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The App Group the app and its extension share (phase 4i): the app leaves the home-screen
     widget's figures there (WidgetSnapshot.swift), and the widget reads them. CarPlay's Driving
     Task permission (phase 4f), which Apple granted Dually's App ID on 2026-11-12 (ADR-014). -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.top.dually.triptracker</string>
	</array>
</dict>
</plist>
